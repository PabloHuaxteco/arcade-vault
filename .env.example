# Variables de entorno para el formulario de contacto (/acerca)
# Copia este archivo a .env.local y rellena los valores.

# API key generada en el panel de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Dirección de destino de los mensajes de contacto.
# Con el remitente onboarding@resend.dev, Resend solo entrega a la
# dirección dueña de la cuenta Resend.
CONTACT_TO=


SUPABASE_DB_PASSWORD=

# Conexión con Supabase (clientes @supabase/ssr).
# Se sacan del panel de Supabase → Project Settings → API Keys.
# NEXT_PUBLIC_SUPABASE_URL: https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: clave sb_publishable_… (pública por diseño)
#
# Dev vs producción: hay dos proyectos Supabase distintos, uno por entorno.
# SUPABASE_DB_PASSWORD y las dos variables de abajo son POR PROYECTO — nunca
# mezcles valores de un proyecto con otro. `.env.local` (este archivo, ya
# relleno) siempre apunta al proyecto de DESARROLLO; para producción usa
# `.env.production.local` (ver `.env.production.local.example` y
# `supabase/RUNBOOK-produccion.md`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
